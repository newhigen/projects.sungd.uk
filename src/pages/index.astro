---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const all = await getCollection('projects');

function num(p: string) {
  const m = p.match(/(\d{4})\.(\d{2})(?:\.(\d{2}))?/);
  return m ? Number(m[1]) * 10000 + Number(m[2]) * 100 + Number(m[3] ?? 0) : 0;
}
function year(p: string) { return p.slice(0, 4); }
function md(p: string) { return p.slice(5); }   // 05.30 · 05

const sorted = [...all].sort((a, b) => num(b.data.period) - num(a.data.period));
const live = sorted.filter(p => !p.data.draft);
const past = sorted.filter(p => p.data.draft);

// 지나온 것은 시간순 — 연도로만 끊는다.
const byYear = new Map<string, typeof past>();
for (const p of past) {
  const y = year(p.data.period);
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(p);
}
---

<Base title="프로젝트">
  <p class="lede">
    직접 쓰려고 만든 앱과 도구. 대개 내 하루에 걸리적거리던 것에서 시작했고, 만든 뒤에도
    계속 쓰고 있는 것만 올려 둔다.
  </p>

  {live.length > 0 && (
    <section>
      <h2 class="sec">지금 쓰는 것<span class="n">{live.length}</span></h2>
      <div class="cards">
        {live.map(p => (
          <a class="card" href={`/${p.id}`}>
            {p.data.icon && <img class="icon" src={p.data.icon} alt="" />}
            <div class="nm">{p.data.title}</div>
            <p class="ds">{p.data.tagline}</p>
            <div class="mt">
              {[p.data.tags[0], p.data.period].filter(Boolean).join(' · ')}
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  {past.length > 0 && (
    <section>
      <h2 class="sec">지나온 것<span class="n">{past.length}</span></h2>
      <p class="note">만들고 쓴 순서대로. 페이지는 아직 안 열었다.</p>
      <div class="tl">
        {[...byYear.entries()].map(([y, items]) => (
          <>
            <div class="yr">{y}</div>
            {items.map(p => (
              <div class="ev">
                <span class="dt">{md(p.data.period)}</span>
                <span class="nm">{p.data.title}</span>
                <span class="ds">{p.data.tagline}</span>
              </div>
            ))}
          </>
        ))}
      </div>
    </section>
  )}
</Base>
