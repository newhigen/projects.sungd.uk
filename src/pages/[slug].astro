---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';

export async function getStaticPaths() {
  const all = await getCollection('projects');
  return all.map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<Base title={d.title} description={d.tagline} image={d.cover}>
  <header class="head">
    <h1>{d.title}</h1>
    <p class="tagline">{d.tagline}</p>
    <div class="meta">
      <span>{d.period}</span>
      {d.tags.length > 0 && <span>{d.tags.join(' · ')}</span>}
      {d.github && <a href={d.github}>GitHub ↗</a>}
      {d.link && <a href={d.link}>{d.linkLabel ?? '열어보기'} ↗</a>}
    </div>
    {d.use.length > 0 && (
      <ul class="use">{d.use.map(u => <li>{u}</li>)}</ul>
    )}
  </header>

  {d.headCover && d.cover && (
    <figure>
      <img src={d.cover} alt="" class:list={[{ 'only-dark': d.coverLight }]} />
      {d.coverLight && <img src={d.coverLight} alt="" class="only-light" />}
    </figure>
  )}

  <article class="prose">
    <Content />
  </article>

  {d.shots.length > 0 && (
    <section>
      <h2 class="group-label">그전 모습</h2>
      <div class="shots">
        {d.shots.map(s => (
          <figure>
            <img src={s.src} alt={s.label} loading="lazy" />
            <figcaption>{s.label}{s.note && <><br />{s.note}</>}</figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}
</Base>
