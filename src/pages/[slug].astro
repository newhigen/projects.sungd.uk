---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';

export async function getStaticPaths() {
  // 아직 안 여는 것은 페이지도 안 만든다 — 목록에 이름만 남는다.
  const all = await getCollection('projects');
  return all
    .filter(entry => !entry.data.draft)
    .map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<Base title={d.title} description={d.tagline} image={d.cover}>
  <header class="doc-head">
    <h1>{d.title}</h1>
    <p class="tagline">{d.tagline}</p>
  </header>

  <div class="doc-body">
    <aside class="rail">
      <dl>
        <dt>언제</dt>
        <dd class="when">{d.period}</dd>
        {d.tags.length > 0 && <><dt>무엇으로</dt><dd>{d.tags.join(' · ')}</dd></>}
        {(d.github || d.link) && (
          <>
            <dt>열어보기</dt>
            {d.github && <dd><a href={d.github}>GitHub ↗</a></dd>}
            {d.link && <dd><a href={d.link}>{d.linkLabel ?? '사이트'} ↗</a></dd>}
          </>
        )}
      </dl>
      {d.use.length > 0 && <ul>{d.use.map(u => <li>{u}</li>)}</ul>}
    </aside>

    <div>
      {d.headCover && d.cover && (
        <figure>
          <img src={d.cover} alt="" class:list={[{ 'only-dark': d.coverLight }]} />
          {d.coverLight && <img src={d.coverLight} alt="" class="only-light" />}
        </figure>
      )}

      <article class="prose">
        <Content />
      </article>

      {d.shots.length > 0 && (
        <section>
          <h2 class="prose">그전 모습</h2>
          <div class="shots">
            {d.shots.map(s => (
              <figure>
                <img src={s.src} alt={s.label} loading="lazy" />
                <figcaption>{s.label}{s.note && <><br />{s.note}</>}</figcaption>
              </figure>
            ))}
          </div>
        </section>
      )}
    </div>
  </div>
</Base>
