---
/** 왼쪽 난에 붙는 절 목차. 본문의 h2 를 그대로 잇는다 */
interface Props {
  items: { slug: string; text: string }[];
}
const { items } = Astro.props;
---

{items.length > 1 && (
  <nav class="toc" aria-label="차례">
    <div class="lb">차례</div>
    <ol>
      {items.map(h => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
    </ol>
  </nav>
)}
