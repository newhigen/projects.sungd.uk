---
/** 왼쪽 난에 붙는 목차. 본문의 h2 를 그대로 잇고, 지금 읽는 절을 진하게 표시한다 */
interface Props {
  items: { slug: string; text: string }[];
}
const { items } = Astro.props;
---

{items.length > 1 && (
  <nav class="toc" aria-label="목차">
    <div class="lb">목차</div>
    <ol>
      {items.map(h => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
    </ol>
  </nav>
)}

<script>
  // 화면 위쪽 1/3 선을 지난 마지막 절이 «지금 읽는 절» 이다
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
  const heads = links
    .map(a => document.getElementById(decodeURIComponent(a.hash.slice(1))))
    .filter((h): h is HTMLElement => !!h);
  if (heads.length) {
    const mark = () => {
      const line = window.innerHeight / 3;
      let cur = 0;
      heads.forEach((h, i) => { if (h.getBoundingClientRect().top <= line) cur = i; });
      links.forEach((a, i) => a.classList.toggle('on', i === cur));
    };
    addEventListener('scroll', mark, { passive: true });
    addEventListener('resize', mark);
    mark();
  }
</script>
