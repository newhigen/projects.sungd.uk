---
import { getEntry } from 'astro:content';
interface Props {
  /** 지금 보고 있는 쪽 */
  here: 'intro' | 'why' | 'making';
  slug: string;
}
const { here, slug } = Astro.props;
// 판이 있는 것만 탭으로 세운다 — 없는 판에 링크를 내지 않는다
const hasWhy = !!(await getEntry('why', slug));
const hasMaking = !!(await getEntry('making', slug));
---

<nav class="tabs">
  <a href={`/${slug}`} class:list={[{ on: here === 'intro' }]}>소개</a>
  {hasWhy && <a href={`/${slug}/why`} class:list={[{ on: here === 'why' }]}>왜 만들었나</a>}
  {hasMaking && <a href={`/${slug}/making`} class:list={[{ on: here === 'making' }]}>개발기</a>}
</nav>
