---
interface Props {
  /** 지금 보고 있는 쪽 */
  here: 'intro' | 'making';
  slug: string;
}
const { here, slug } = Astro.props;
const links = [
  { to: `/${slug}`, label: '소개', on: here === 'intro' },
  { to: `/${slug}/making`, label: '개발기', on: here === 'making' },
];
---

<nav class="tabs" data-tabs>
  {links.map(l => <a href={l.to} class:list={[{ on: l.on }]}>{l.label}</a>)}
</nav>

{/* 머리의 칩이 화면 밖으로 나가면 같은 칩이 그 자리에서 떠오른다.
    이름은 안 넣는다 — 넣으면 폭이 달라져 칩이 옆으로 밀린다 */}
<div class="tabfloat" data-tabfloat aria-hidden="true">
  <nav class="seg">
    {links.map(l => <a href={l.to} class:list={[{ on: l.on }]}>{l.label}</a>)}
  </nav>
</div>

<script>
  const head = document.querySelector('[data-tabs]');
  const bar = document.querySelector('[data-tabfloat]');
  if (head && bar) {
    // 머리의 칩이 보이는 동안은 띠가 없다 — 같은 것을 두 번 세우지 않는다
    const io = new IntersectionObserver(([e]) => {
      bar.classList.toggle('on', !e.isIntersecting);
      bar.setAttribute('aria-hidden', String(e.isIntersecting));
    }, { threshold: 0 });
    io.observe(head);
  }
</script>
