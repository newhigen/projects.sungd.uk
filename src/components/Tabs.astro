---
interface Props {
  /** 지금 보고 있는 쪽 */
  here: 'intro' | 'making';
  slug: string;
}
const { here, slug } = Astro.props;
const links = [
  { to: `/${slug}`, label: '소개', on: here === 'intro' },
  { to: `/${slug}/making`, label: '개발기', on: here === 'making' },
];
---

{/* 붙었는지 재는 자리 — 이게 화면 위로 빠져나가면 칩이 유리로 바뀐다 */}
<div class="tabmark" data-tabmark aria-hidden="true"></div>

<nav class="tabs" data-tabs>
  {links.map(l => <a href={l.to} class:list={[{ on: l.on }]}>{l.label}</a>)}
</nav>

<script>
  const mark = document.querySelector('[data-tabmark]');
  const tabs = document.querySelector('[data-tabs]');
  if (mark && tabs) {
    // 자리는 sticky 가 잡는다 — 스크립트는 「붙었다」 는 것만 알려 준다
    new IntersectionObserver(
      ([e]) => tabs.classList.toggle('stuck', !e.isIntersecting),
      { rootMargin: '-14px 0px 0px 0px', threshold: 0 },
    ).observe(mark);
  }
</script>
