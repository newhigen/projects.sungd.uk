---
interface Props {
  /** 지금 보고 있는 쪽 */
  here: 'intro' | 'making';
  slug: string;
}
const { here, slug } = Astro.props;
const links = [
  { to: `/${slug}`, label: '소개', on: here === 'intro' },
  { to: `/${slug}/making`, label: '개발기', on: here === 'making' },
];
---

{/* 흰 카드 안 오른쪽 위 — 글이 비켜 흐르고, 스크롤하면 카드 안에서 따라 올라붙는다 */}
<nav class="tabs" data-tabs>
  {links.map(l => <a href={l.to} class:list={[{ on: l.on }]}>{l.label}</a>)}
</nav>

<script>
  const tabs = document.querySelector('[data-tabs]') as HTMLElement | null;
  if (tabs) {
    // 붙었는지는 자리로 안다 — 붙은 뒤에 바닥과 그림자만 바뀐다
    const line = parseFloat(getComputedStyle(tabs).top) + 1;
    let queued = false;
    const check = () => {
      queued = false;
      tabs.classList.toggle('stuck', tabs.getBoundingClientRect().top <= line);
    };
    addEventListener('scroll', () => {
      if (!queued) { queued = true; requestAnimationFrame(check); }
    }, { passive: true });
    check();
  }
</script>
